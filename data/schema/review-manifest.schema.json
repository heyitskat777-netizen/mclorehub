{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mclorehub:reviews:1",
  "title": "Local source-bound acceptance review decisions",
  "type": "object",
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "decisions": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["document_id", "revision_sha256", "review_fingerprint", "status", "reviewer", "reviewed_at", "evidence"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^lotc:topic:[1-9][0-9]{0,17}$"},
          "revision_sha256": {"$ref": "#/$defs/hash"},
          "review_fingerprint": {"$ref": "#/$defs/hash"},
          "status": {"enum": ["unknown", "accepted_current", "legacy", "shelved", "superseded", "pending"]},
          "reviewer": {"type": "string", "pattern": "\\S"},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["source_url", "passage"],
              "properties": {
                "source_url": {"type": "string", "format": "uri", "pattern": "^https://(www\\.)?lordofthecraft\\.net/forums/topic/"},
                "passage": {"type": "string", "pattern": "\\S"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
