{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mclorehub:candidate-pack:1",
  "title": "Unreviewed import candidate, not an active database",
  "type": "object",
  "required": ["schema_version", "importer_version", "revision_id", "kind", "snapshot_scope", "source", "documents"],
  "properties": {
    "schema_version": {"const": 1}, "importer_version": {"const": "1"},
    "revision_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "kind": {"const": "review_candidate"}, "snapshot_scope": {"const": "partial"},
    "source": {
      "type": "object", "required": ["input_sha256", "json_sha256", "snapshot_at", "export_provenance"],
      "properties": {
        "input_sha256": {"$ref": "#/$defs/hash"}, "json_sha256": {"$ref": "#/$defs/hash"},
        "snapshot_at": {"type": "string", "format": "date-time"}, "export_provenance": {"type": "object"}
      }
    },
    "documents": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/document"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document": {
      "type": "object",
      "required": ["id", "title", "source_url", "source_snapshot_at", "revision_sha256", "formatting_fidelity", "status", "blocks", "coverage_gaps", "source_record"],
      "properties": {
        "id": {"type": "string", "pattern": "^lotc:topic:[1-9][0-9]{0,17}$"},
        "title": {"type": "string", "pattern": "\\S"}, "source_url": {"type": "string", "format": "uri"},
        "source_snapshot_at": {"type": "string", "format": "date-time"},
        "revision_sha256": {"$ref": "#/$defs/hash"}, "formatting_fidelity": {"const": "plain_text"},
        "status": {
          "type": "object", "required": ["value", "requires_review", "reason"],
          "properties": {"value": {"const": "unknown"}, "requires_review": {"const": true}, "reason": {"type": "string", "pattern": "\\S"}}
        },
        "blocks": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "object", "required": ["id", "type", "text"],
            "properties": {"id": {"const": "body"}, "type": {"const": "plain_text"}, "text": {"type": "string", "pattern": "\\S"}}}
        },
        "coverage_gaps": {"type": "array", "items": {"type": "string"}}, "source_record": {"type": "object"}
      }
    }
  }
}
