{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mclorehub.local/schema/character-lore.schema.json",
  "title": "Curated main-post character lore and initial rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curated_on",
    "scope",
    "sources",
    "options",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "curated_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "revision",
          "main_fingerprint",
          "snapshot",
          "passages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lotc:topic:[1-9][0-9]{0,17}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "main_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot": {
            "type": "string",
            "format": "date-time"
          },
          "passages": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "kind",
          "source_id",
          "notes"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "MAGIC",
              "CA",
              "FA"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^lotc:topic:[1-9][0-9]{0,17}$"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "left",
          "right",
          "sources",
          "summary"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "EXCLUSION",
              "SOURCE_CONFLICT",
              "BRANCH_EXCLUSION",
              "CONDITIONAL_NOTICE"
            ]
          },
          "left": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "right": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^lotc:topic:[1-9][0-9]{0,17}$"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
